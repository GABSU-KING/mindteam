# ───────────────────────────────────────────────
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# .env.local 은 .gitignore 에 들어 있습니다.
# ───────────────────────────────────────────────

# Supabase > Project Settings > API
# 이 두 개는 브라우저로 내려갑니다. anon key 는 공개되어도 되는 키입니다(RLS가 보호).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# console.anthropic.com
# NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요. 서버 라우트에서만 읽습니다.
ANTHROPIC_API_KEY=sk-ant-...

# ── 모델 ────────────────────────────────────────
# 판단이 필요한 작업(개입 응답·분석·자아 합성·감정 생성·주간 편지)에 쓰는 모델.
# CLAUDE.md 지정값입니다. 더 최신 모델을 쓰려면 claude-sonnet-5 로 바꾸세요.
ANTHROPIC_MODEL=claude-sonnet-4-6

# 감정들끼리 끊임없이 떠드는 평소 대화에 쓰는 모델.
# 호출이 압도적으로 많은 쪽이라 저렴한 모델을 씁니다 — 이걸 sonnet 으로 올리면
# 같은 예산으로 볼 수 있는 시간이 3분의 1 정도로 줄어듭니다.
ANTHROPIC_MODEL_AMBIENT=claude-haiku-4-5

# ── 예산 ────────────────────────────────────────
# 한 달(한국 시간 기준 매월 1일 리셋) 최대 지출액, USD.
# 서버가 LLM 을 부르기 직전에 usage_ledger 를 합산해 이 값을 넘지 않도록 막습니다.
# 표시용이 아니라 실제 차단선입니다.
MONTHLY_BUDGET_USD=20
