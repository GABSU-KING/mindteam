# ───────────────────────────────────────────────
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# .env.local 은 .gitignore 에 들어 있습니다.
# ───────────────────────────────────────────────

# Supabase > Project Settings > API
# 이 두 개는 브라우저로 내려갑니다. anon key 는 공개되어도 되는 키입니다(RLS가 보호).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# console.anthropic.com
# NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요. 서버 라우트에서만 읽습니다.
ANTHROPIC_API_KEY=sk-ant-...

# CLAUDE.md 지정 모델. 더 최신 모델을 쓰려면 claude-sonnet-5 로 바꾸세요.
ANTHROPIC_MODEL=claude-sonnet-4-6
